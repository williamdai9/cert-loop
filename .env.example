# Create a dedicated Supabase project, then copy its public browser credentials.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Required to activate the whole-site AI Tutor.
# Vercel production can instead use its automatic short-lived VERCEL_OIDC_TOKEN.
OPENAI_API_KEY=your-openai-api-key
OPENAI_TUTOR_MODEL=gpt-5.6-terra
AI_GATEWAY_API_KEY=optional-local-vercel-ai-gateway-key
AI_GATEWAY_TUTOR_MODEL=openai/gpt-5.6-terra
AI_GATEWAY_RESEARCH_MODEL=openai/gpt-5.6-luna
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# Optional Supabase Edge Function secret for AI research digests/question drafts.
# The daily open-research metadata sync works without it.
OPENAI_RESEARCH_MODEL=gpt-5.6-luna
