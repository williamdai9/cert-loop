# Create a dedicated Supabase project, then copy its public browser credentials.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Required to activate the whole-site AI Tutor.
OPENAI_API_KEY=your-openai-api-key
OPENAI_TUTOR_MODEL=gpt-5.4
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# Server-only bearer secret for the lightweight Supabase keep-alive cron.
CRON_SECRET=replace-with-a-random-secret
